<?xml version="1.0" encoding="utf-8"?>
<!--
  Default locale (English). This file is the fallback for any locale without a
  translation. Spanish lives in res/values-es/strings.xml.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:locale="en">

    <!-- Product name: deliberately identical in every language. -->
    <string name="app_name" translatable="false">Yahora</string>

    <string name="tag_cloud_empty">No tags yet</string>
    <string name="tag_cloud_empty_hint">Add one to start logging with a single tap.</string>
    <string name="favorite_tag">Favorite</string>

    <string name="add_tag">Add tag</string>
    <string name="add_tag_dialog_title">New tag</string>
    <string name="tag_name_label">Name</string>
    <string name="tag_name_error_blank">Enter a name</string>
    <string name="tag_name_error_duplicate">A tag with that name already exists</string>
    <string name="tag_name_error_too_long">That name is too long</string>
    <!-- %1$d is the current length, %2$d the maximum allowed. -->
    <string name="tag_name_counter">%1$d/%2$d</string>
    <string name="action_create">Create</string>
    <string name="action_cancel">Cancel</string>
    <!-- Takes back the tap that logged an entry, while the snackbar is up. -->
    <string name="action_undo">Undo</string>

    <!-- %1$s is the tag name, %2$s the time the entry was logged at. -->
    <string name="entry_logged">%1$s logged at %2$s</string>
    <string name="entry_failed">Could not log %1$s: that tag no longer exists</string>

    <string name="rename_failed">Could not rename %1$s: that tag no longer exists</string>
    <string name="delete_failed">Could not delete %1$s: it has entries now</string>

    <!-- Long-press context menu. -->
    <string name="tag_menu_view_entries">View entries</string>
    <string name="tag_menu_rename">Rename</string>
    <string name="tag_menu_delete">Delete</string>
    <string name="tag_menu_favorite">Mark as favorite</string>
    <string name="tag_menu_unfavorite">Remove from favorites</string>

    <!-- %1$s is the tag's current name. -->
    <string name="rename_tag_dialog_title">Rename %1$s</string>
    <string name="action_rename">Rename</string>

    <!-- Tag detail screen. -->
    <string name="action_back">Back</string>
    <string name="tag_detail_empty">No entries yet</string>
    <string name="tag_detail_expand">Expand</string>
    <string name="tag_detail_collapse">Collapse</string>
    <!--
      java.time patterns for the tree rows. Translations should reword them to
      whatever reads naturally in the locale: adding a language must never mean
      touching Kotlin. LLLL is the standalone month name, EEEE the weekday.
    -->
    <string name="month_year_pattern">LLLL yyyy</string>
    <string name="day_pattern">EEEE d</string>
    <!-- An entry states the second it was logged at, so two taps never look alike. -->
    <string name="entry_time_pattern">HH:mm:ss</string>

    <!-- How many children a collapsed row holds. -->
    <plurals name="day_count">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>
    <plurals name="entry_count">
        <item quantity="one">%d entry</item>
        <item quantity="other">%d entries</item>
    </plurals>
</resources>
