<?xml version="1.0" encoding="utf-8"?>
<!--
  Default locale (English). This file is the fallback for any locale without a
  translation. Spanish lives in res/values-es/strings.xml.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:locale="en">

    <!-- Product name: deliberately identical in every language. -->
    <string name="app_name" translatable="false">Yahora</string>

    <string name="tag_cloud_empty">No tags yet</string>
    <string name="tag_cloud_empty_hint">Add one to start logging with a single tap.</string>
    <string name="favorite_tag">Favorite</string>

    <string name="add_tag">Add tag</string>
    <string name="add_tag_dialog_title">New tag</string>
    <string name="tag_name_label">Name</string>
    <string name="tag_name_error_blank">Enter a name</string>
    <string name="tag_name_error_duplicate">A tag with that name already exists</string>
    <string name="tag_name_error_too_long">That name is too long</string>
    <!-- %1$d is the current length, %2$d the maximum allowed. -->
    <string name="tag_name_counter">%1$d/%2$d</string>
    <string name="action_create">Create</string>
    <string name="action_cancel">Cancel</string>
    <!-- Takes back the tap that logged an entry, while the snackbar is up. -->
    <string name="action_undo">Undo</string>

    <!-- %1$s is the tag name, %2$s the time the entry was logged at. -->
    <string name="entry_logged">%1$s logged at %2$s</string>
    <string name="entry_failed">Could not log %1$s: that tag no longer exists</string>

    <string name="rename_failed">Could not rename %1$s: that tag no longer exists</string>
    <string name="delete_failed">Could not delete %1$s: it has entries now</string>

    <!-- Long-press context menu. -->
    <string name="tag_menu_view_entries">View entries</string>
    <string name="tag_menu_rename">Rename</string>
    <string name="tag_menu_delete">Delete</string>
    <!-- Debug builds only: discards the tag together with its history. -->
    <string name="tag_menu_purge">Delete with its entries</string>
    <string name="tag_menu_favorite">Mark as favorite</string>
    <string name="tag_menu_unfavorite">Remove from favorites</string>

    <!-- %1$s is the tag's current name. -->
    <string name="rename_tag_dialog_title">Rename %1$s</string>
    <string name="action_rename">Rename</string>

    <!-- Backup: the overflow menu of the tag cloud. -->
    <string name="more_options">More options</string>
    <string name="menu_save_backup">Back up</string>
    <string name="menu_restore_backup">Restore backup</string>
    <!-- %1$s is a count of entries, such as "12 entries". -->
    <string name="backup_saved">Backup saved with %1$s</string>
    <string name="backup_failed">Could not save the backup</string>
    <string name="restore_refused_not_a_backup">That file is not a Yahora backup</string>
    <string name="restore_refused_newer_version">That backup comes from a newer version of Yahora. Update the app to restore it.</string>
    <string name="restore_refused_damaged">That backup is damaged and cannot be restored</string>
    <string name="restore_refused_unreadable">Could not read that file</string>
    <string name="restore_dialog_title">Replace your log?</string>
    <!--
      %1$s is the date the backup was made, %2$s the time, %3$s a count of tags
      and %4$s a count of entries.
    -->
    <string name="restore_dialog_text">This backup was made on %1$s at %2$s and holds %3$s and %4$s. Everything logged on this phone now will be replaced by it. This cannot be undone.</string>
    <string name="action_restore">Restore</string>
    <!-- %1$s is a count of entries, such as "12 entries". -->
    <string name="restore_done">Log restored with %1$s</string>
    <string name="restore_failed">Could not restore the backup. Your log is unchanged.</string>

    <!-- Tag detail screen. -->
    <string name="action_back">Back</string>
    <string name="tag_detail_empty">No entries yet</string>
    <string name="entry_menu_delete">Delete</string>
    <string name="delete_entry_dialog_title">Delete this entry?</string>
    <!-- %1$s is the time the entry was logged at. -->
    <string name="delete_entry_dialog_text">It was logged at %1$s. This cannot be undone.</string>
    <string name="action_delete">Delete</string>
    <string name="purge_tag_dialog_title">Delete %1$s and its entries?</string>
    <string name="purge_tag_dialog_text">Every entry logged under this tag goes with it. This cannot be undone.</string>
    <!-- Empties the tag's history; the tag itself stays. -->
    <string name="tag_detail_delete_all">Delete all entries</string>
    <!-- %1$s is the tag name, %2$s a month such as "August 2026". -->
    <string name="bulk_delete_month_text">Every entry of %1$s in %2$s will be deleted. This cannot be undone.</string>
    <!-- %1$s is the tag name, %2$s a full date. -->
    <string name="bulk_delete_day_text">Every entry of %1$s on %2$s will be deleted. This cannot be undone.</string>
    <!-- %1$s is the tag name. -->
    <string name="bulk_delete_all_text">Every entry of %1$s will be deleted. The tag stays, empty. This cannot be undone.</string>
    <string name="tag_detail_expand">Expand</string>
    <string name="tag_detail_collapse">Collapse</string>
    <!--
      java.time patterns for the tree rows. Translations should reword them to
      whatever reads naturally in the locale: adding a language must never mean
      touching Kotlin. LLLL is the standalone month name, EEEE the weekday.
    -->
    <string name="month_year_pattern">LLLL yyyy</string>
    <string name="day_pattern">EEEE d</string>
    <!-- An entry states the second it was logged at, so two taps never look alike. -->
    <string name="entry_time_pattern">HH:mm:ss</string>

    <!-- How many children a collapsed row holds. -->
    <plurals name="day_count">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>
    <!-- Long-press menu of a month or a day in the history. -->
    <plurals name="delete_entries_action">
        <item quantity="one">Delete %d entry</item>
        <item quantity="other">Delete %d entries</item>
    </plurals>
    <plurals name="bulk_delete_dialog_title">
        <item quantity="one">Delete %d entry?</item>
        <item quantity="other">Delete %d entries?</item>
    </plurals>
    <plurals name="tag_count">
        <item quantity="one">%d tag</item>
        <item quantity="other">%d tags</item>
    </plurals>
    <plurals name="entry_count">
        <item quantity="one">%d entry</item>
        <item quantity="other">%d entries</item>
    </plurals>
</resources>
